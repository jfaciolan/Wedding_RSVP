# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Leave unset for SQLite (db.sqlite3). Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Absolute site address, used for invite links and Open Graph tags.
SITE_URL=http://localhost:8000
# Optional RSVP rate limit per IP (posts per window in seconds).
RSVP_RATE_LIMIT=10
RSVP_RATE_WINDOW=600
